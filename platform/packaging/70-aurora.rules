# Aurora USB transport: lets the logged-in user switch phones to Android Open
# Accessory mode and talk to them. Vendor list = ANDROID_VENDORS in
# crates/transport/src/usb/host.rs.

# Android Open Accessory mode (Google vendor id)
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="2d0[0-5]", TAG+="uaccess"

# Phones before the switch
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="04e8", TAG+="uaccess"
